# ==============================================================================
# RITZ Wallet - Environment Configuration Template
# Rajalakshmi Institute of Technology (RIT)
# ==============================================================================

# ==========================================
# 1. Server Configuration
# ==========================================
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=mysql
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost:8085,https://ritz.ritchennai.edu.in

# ==========================================
# 2. Database Configuration (MySQL 8+)
# ==========================================
DB_ROOT_PASSWORD=RootSecurePass2026!
DB_NAME=ritz_wallet
DB_USERNAME=ritz_user
DB_PASSWORD=RitzWalletPass2026!
DB_HOST=ritz-mysql
DB_PORT=3306
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata&characterEncoding=UTF-8

# (Optional: PostgreSQL Configuration if profile=default is selected)
PG_DB_NAME=ritz_token_db
PG_DB_USER=ritz_admin
PG_DB_PASS=RitzSecurePassword2026

# ==========================================
# 3. JWT Authentication & Security
# ==========================================
# Minimum 256-bit secure secret key for HMAC-SHA256 signature verification
JWT_SECRET=RITZWalletSecureJwtTokenSigningSecretKeyWithMin256BitsLength2026!
# Token validity in hours (default: 24 hours)
JWT_EXPIRATION_HOURS=24
# Refresh token validity in days (default: 7 days)
JWT_REFRESH_EXPIRATION_DAYS=7

# Master legacy API Key for backward compatibility
RITZ_API_KEY=ritz-secret-api-key-2026

# ==========================================
# 4. Token & Monetary Valuation Settings
# ==========================================
# Defines conversion rate: tokens = rupees * rate
# Default: 1.0 (1 INR = 1 RITZ Token). 100 paise = 100 minor units.
TOKEN_EXCHANGE_RATE=1.0

# ==========================================
# 5. Razorpay Payment Gateway (Test / Production)
# ==========================================
# CRITICAL COMPLIANCE NOTICE:
# Keep disabled (false) until merchant legal approval and RBI/PPI requirements are satisfied.
# When disabled, RITZ Wallet operates in safe Sandbox mode for local simulation.
PAYMENT_RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ==========================================
# 6. Default Administrative Credentials
# (Auto-seeded on fresh database initialization)
# ==========================================
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=RitzAdmin2026!
FINANCE_ADMIN_USERNAME=financeadmin
FINANCE_ADMIN_PASSWORD=RitzFinance2026!
MERCHANT_ADMIN_USERNAME=tilloadmin
MERCHANT_ADMIN_PASSWORD=TilloPass2026!
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=RitzDev2026!
STUDENT_USERNAME=RIT2026001
STUDENT_PASSWORD=StudentPass2026!
